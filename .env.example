# TMDB API Read Access Token (Bearer token), available from your TMDB account API settings.
TMDB_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token

# Yellow unlock password, used by `npm run yellow:encrypt` / `npm run yellow:decrypt`.
# Leave it out to be prompted instead. Never commit the real value.
# YELLOW_PASSWORD=

# Optional local development overrides.
PORT=4173
HOST=127.0.0.1
